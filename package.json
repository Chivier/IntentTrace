{
  "name": "intenttrace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/check-docs.mjs",
    "docker:up": "node scripts/docker-stack.mjs up",
    "docker:url": "node scripts/docker-stack.mjs url",
    "docker:status": "node scripts/docker-stack.mjs status",
    "docker:down": "node scripts/docker-stack.mjs down",
    "docker:check": "node scripts/check-compose.mjs",
    "demo:load": "tsx scripts/load-demo.ts",
    "desktop:prepare": "node scripts/prepare-desktop-stack.mjs",
    "desktop:check": "pnpm desktop:prepare && pnpm --filter @intenttrace/desktop check",
    "desktop:dev": "pnpm --filter @intenttrace/desktop tauri dev",
    "desktop:build": "pnpm --filter @intenttrace/desktop tauri build --bundles dmg",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "performance:smoke": "tsx scripts/performance-smoke.ts",
    "schema:generate": "pnpm --filter @intenttrace/schema generate && pnpm --filter @intenttrace/api openapi:generate",
    "schema:check": "pnpm --filter @intenttrace/schema generate -- --check && pnpm --filter @intenttrace/api openapi:generate -- --check && pnpm --filter @intenttrace/db schema:check",
    "db:generate": "pnpm --filter @intenttrace/db generate",
    "db:migrate": "pnpm --filter @intenttrace/config build && pnpm --filter @intenttrace/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@tauri-apps/cli": "2.11.4",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
